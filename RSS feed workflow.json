    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet emailHtml = `\n<h2>📰 Today's Top News Headlines</h2>\n<p>Here are the latest articles from the RSS feed:</p>\n<ol>\n`;\n\nlet telegramText = `📰 TODAY'S TOP NEWS HEADLINES\\n\\n`;\n\nitems.forEach((item, index) => {\n  const title = item.json.title || 'No title available';\n  const link = item.json.link || '';\n  const description =\n    item.json.contentSnippet ||\n    item.json.description ||\n    'No description available';\n\n  emailHtml += `\n<li>\n<strong>${title}</strong><br>\n${description}<br>\n<a href=\"${link}\">🔗 Read Full Article</a>\n</li>\n<br>\n`;\n\n  telegramText += `${index + 1}. ${title}\\n`;\n  telegramText += `📝 ${description}\\n`;\n  telegramText += `🔗 ${link}\\n\\n`;\n});\n\nemailHtml += `\n</ol>\n<p>🤖 Automated by n8n</p>\n`;\n\ntelegramText += `🤖 Automated by n8n`;\n\nreturn [\n  {\n    json: {\n      emailHtml,\n      telegramText\n    }\n  }\n];"
      },
